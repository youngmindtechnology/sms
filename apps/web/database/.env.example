# Copy this file to `.env` (same folder) and replace the placeholders.
# `.env` is ignored by Git. NEVER commit real credentials, and never paste them
# into chat, screenshots, issues or commit messages.

# What this checkout is. The scripts refuse to run for anything except
# "development" or "test".
YMT_ENV="development"

# ---------------------------------------------------------------------------
# Option A: Supabase development project (ymt-school-management-dev)
# ---------------------------------------------------------------------------
# Supabase dashboard > Connect > "Session pooler" (port 5432). Copy the host
# exactly as shown there. The user is  prisma.<PROJECT_REF>  (the dedicated role
# described in database/README.md). The password must be URL-encoded
# (for example "@" becomes %40, "/" becomes %2F, "!" becomes %21).
# Keep ?schema=public. Do NOT use port 6543 (transaction pooler) here.
DATABASE_URL=postgresql://USER:qwertyuiop@localhost:5432/ymt_dev?schema=public# Do not add host=, port=, dbname= or user= parameters: the safety scripts refuse them.

# The 20-character Reference ID of the DEV project only
# (dashboard > Project Settings > General). It is an identifier, not a secret.
# To approve a second (test) project, list both separated by a comma.
# Scripts refuse to touch any other Supabase project, and the seed/migrate
# commands additionally need  --approve-target=<this ref>  on the command line.
YMT_APPROVED_TARGET_REF="PROJECT_REF"

# ---------------------------------------------------------------------------
# Option B: local PostgreSQL instead (the database name must end in _dev)
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://ymt_dev_user:CHANGE_ME@localhost:5432/ymt_dev?schema=public"
# (YMT_APPROVED_TARGET_REF is not needed for local _dev / _test databases)

# ---------------------------------------------------------------------------
# Constraint tests: use a SEPARATE, EMPTY database. Recommended: local
# PostgreSQL. The name must end in _test.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:qwertyuiop@localhost:5432/ymt_dev?schema=public