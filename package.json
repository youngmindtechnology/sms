{
  "name": "ymt-school-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/web/database"
  ],
  "scripts": {
  "dev:web": "npm run dev --workspace=web",
  "build:web": "npm run build --workspace=web",
  "lint:web": "npm run lint --workspace=web",
  "db:validate": "node --env-file=./apps/web/database/.env ./apps/web/database/node_modules/prisma/build/index.js validate --schema ./apps/web/database/prisma/schema.prisma",
  "db:migrate:status": "node --env-file=./apps/web/database/.env ./apps/web/database/node_modules/prisma/build/index.js migrate status --schema ./apps/web/database/prisma/schema.prisma",
  "db:generate": "npm run prisma:generate --workspace=@ymt/database",
  "db:test": "npm run db:test --workspace=@ymt/database",
  "db:test:guard": "npm run test:guard --workspace=@ymt/database",
  "db:target": "npm run db:target --workspace=@ymt/database"
}
}
